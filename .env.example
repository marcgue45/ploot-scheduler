# Variables por servicio (en el host: Vercel / Railway). Nunca se commitean valores reales.
# --- app (Vercel)
DATABASE_URL=postgres://ploot_app:<password>@<host>:<port>/<db>
DB_POOL_MAX=2
JWT_SECRET=<32+ caracteres aleatorios>
DEMO_MODE=true
DATABASE_SSL=no-verify
# --- worker (Railway)
WORKER_DATABASE_URL=postgres://ploot_worker:<password>@<host>:<port>/<db>
PROVIDER_URL=https://<mock>.up.railway.app
TOKEN_ENC_KEY=<openssl rand -base64 32>
# --- migrate/seed (one-shot)
DATABASE_ADMIN_URL=postgres://postgres:<password>@<host>:<port>/<db>
APP_DB_PASSWORD=<openssl rand -hex 24>
WORKER_DB_PASSWORD=<openssl rand -hex 24>
